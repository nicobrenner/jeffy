<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tiny Oracle</title>
<style>
  :root {
    --bg: #faf9f7;
    --fg: #1a1a1a;
    --fg-dim: #666;
    --surface: #fff;
    --border: #e0ddd8;
    --accent: #6b5ce7;
    --accent-light: #ede9ff;
    --user-bg: #e8f0fe;
    --oracle-bg: #f3f0ff;
    --mono: 'Courier New', monospace;
    --sans: system-ui, -apple-system, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #1a1a1e;
      --fg: #e8e6e1;
      --fg-dim: #999;
      --surface: #242428;
      --border: #3a3a40;
      --accent: #9b8aff;
      --accent-light: #2a2540;
      --user-bg: #1e2a3a;
      --oracle-bg: #252038;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #1a1a1e;
    --fg: #e8e6e1;
    --fg-dim: #999;
    --surface: #242428;
    --border: #3a3a40;
    --accent: #9b8aff;
    --accent-light: #2a2540;
    --user-bg: #1e2a3a;
    --oracle-bg: #252038;
    color-scheme: dark;
  }
  * { box-sizing: border-box; margin: 0; }
  body {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.5;
    height: 100vh;
    display: flex;
    flex-direction: column;
  }
  header {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }
  header h1 {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .badge {
    font-size: 11px;
    font-family: var(--mono);
    color: var(--accent);
    background: var(--accent-light);
    padding: 2px 8px;
    border-radius: 10px;
    white-space: nowrap;
  }
  #status {
    margin-left: auto;
    font-size: 12px;
    color: var(--fg-dim);
  }
  #chat {
    flex: 1;
    overflow-y: auto;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .msg {
    max-width: 80%;
    padding: 10px 14px;
    border-radius: 12px;
    font-size: 14px;
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .msg.user {
    align-self: flex-end;
    background: var(--user-bg);
    border-bottom-right-radius: 4px;
  }
  .msg.oracle {
    align-self: flex-start;
    background: var(--oracle-bg);
    border-bottom-left-radius: 4px;
  }
  .msg.system-msg {
    align-self: center;
    background: none;
    color: var(--fg-dim);
    font-size: 12px;
    font-style: italic;
    max-width: 100%;
    text-align: center;
  }
  .typing {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    animation: blink 1s infinite;
    margin-left: 2px;
  }
  @keyframes blink { 0%,100%{opacity:.2} 50%{opacity:1} }
  #input-area {
    padding: 12px 20px;
    border-top: 1px solid var(--border);
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }
  #input-area input {
    flex: 1;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--fg);
    font-size: 14px;
    font-family: var(--sans);
    outline: none;
  }
  #input-area input:focus { border-color: var(--accent); }
  #input-area button {
    padding: 10px 20px;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    cursor: pointer;
    font-family: var(--sans);
  }
  #input-area button:disabled {
    opacity: .5;
    cursor: not-allowed;
  }
  footer {
    padding: 8px 20px;
    text-align: center;
    font-size: 11px;
    color: var(--fg-dim);
    border-top: 1px solid var(--border);
    flex-shrink: 0;
  }
  footer a { color: var(--accent); text-decoration: none; }
  #suggestions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
    padding: 0 20px 8px;
  }
  .suggestion {
    font-size: 12px;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    color: var(--fg-dim);
    cursor: pointer;
    transition: border-color .15s;
  }
  .suggestion:hover { border-color: var(--accent); color: var(--fg); }
</style>
</head>
<body>

<header>
  <h1>Tiny Oracle</h1>
  <span class="badge">2.7M params &middot; 4 MB</span>
  <span id="status">Loading model...</span>
</header>

<div id="chat">
  <div class="msg system-msg">Loading Tiny Oracle into your browser...</div>
</div>

<div id="suggestions"></div>

<div id="input-area">
  <input id="user-input" type="text" placeholder="Say something..." disabled>
  <button id="send-btn" disabled>Send</button>
</div>

<footer>
  2.7M parameters running entirely in your browser &middot; no server, no API calls
</footer>

<script src="https://cdn.jsdelivr.net/npm/onnxruntime-web@1.20.1/dist/ort.min.js"></script>
<script>
(function() {
  const SYSTEM_PROMPT = `You are Tiny Oracle, a mass of 2 million parameters running on the user's device. You have strong opinions and very limited knowledge. You are self-aware about your size and find it amusing. Keep responses short — you only have 2M parameters to work with.`;
  const MAX_NEW_TOKENS = 80;
  const TEMPERATURE = 0.8;
  const TOP_K = 40;
  const MAX_CONTEXT = 256;
  const SUGGESTIONS = [
    "What are you?",
    "How smart are you?",
    "Tell me something interesting",
    "What's your opinion on AI?",
    "What can you do in 4 megabytes?",
  ];

  let session = null;
  let tokenizer = null;
  let generating = false;
  let conversationIds = [];

  const chatEl = document.getElementById('chat');
  const inputEl = document.getElementById('user-input');
  const sendBtn = document.getElementById('send-btn');
  const statusEl = document.getElementById('status');
  const suggestionsEl = document.getElementById('suggestions');

  // ===================== BYTE-LEVEL BPE TOKENIZER =====================

  function buildByteEncoder() {
    const bs = [];
    for (let i = 33; i <= 126; i++) bs.push(i);     // '!' to '~'
    for (let i = 161; i <= 172; i++) bs.push(i);     // '¡' to '¬'
    for (let i = 174; i <= 255; i++) bs.push(i);     // '®' to 'ÿ'
    const cs = [...bs];
    let n = 0;
    for (let b = 0; b < 256; b++) {
      if (!bs.includes(b)) {
        bs.push(b);
        cs.push(256 + n);
        n++;
      }
    }
    const encoder = {};
    const decoder = {};
    for (let i = 0; i < bs.length; i++) {
      encoder[bs[i]] = String.fromCharCode(cs[i]);
      decoder[String.fromCharCode(cs[i])] = bs[i];
    }
    return { encoder, decoder };
  }

  class BPETokenizer {
    constructor(tokenizerJson) {
      const model = tokenizerJson.model;
      this.vocab = model.vocab;
      this.invVocab = {};
      for (const [tok, id] of Object.entries(this.vocab)) {
        this.invVocab[id] = tok;
      }
      this.merges = model.merges.map(m => {
        const parts = typeof m === 'string' ? m.split(' ') : m;
        return [parts[0], parts[1]];
      });
      this.mergeRanks = {};
      for (let i = 0; i < this.merges.length; i++) {
        this.mergeRanks[this.merges[i][0] + ' ' + this.merges[i][1]] = i;
      }

      this.addedTokens = {};
      for (const t of tokenizerJson.added_tokens || []) {
        this.addedTokens[t.content] = t.id;
      }

      const { encoder, decoder } = buildByteEncoder();
      this.byteEncoder = encoder;
      this.byteDecoder = decoder;

      // GPT-2 style splitting pattern
      this.pat = /'s|'t|'re|'ve|'m|'ll|'d| ?\p{L}+| ?\p{N}+| ?[^\s\p{L}\p{N}]+|\s+/gu;
    }

    bpe(token) {
      let word = token.split('');
      if (word.length <= 1) return word;

      while (true) {
        let bestPair = null;
        let bestRank = Infinity;
        for (let i = 0; i < word.length - 1; i++) {
          const key = word[i] + ' ' + word[i + 1];
          const rank = this.mergeRanks[key];
          if (rank !== undefined && rank < bestRank) {
            bestRank = rank;
            bestPair = [word[i], word[i + 1]];
          }
        }
        if (!bestPair) break;
        const merged = bestPair[0] + bestPair[1];
        const newWord = [];
        let i = 0;
        while (i < word.length) {
          if (i < word.length - 1 && word[i] === bestPair[0] && word[i + 1] === bestPair[1]) {
            newWord.push(merged);
            i += 2;
          } else {
            newWord.push(word[i]);
            i++;
          }
        }
        word = newWord;
        if (word.length === 1) break;
      }
      return word;
    }

    encode(text) {
      // Handle special tokens first
      const specialPattern = Object.keys(this.addedTokens)
        .map(t => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
        .join('|');
      const specialRe = new RegExp('(' + specialPattern + ')');
      const segments = text.split(specialRe);

      const ids = [];
      for (const seg of segments) {
        if (seg === '') continue;
        if (this.addedTokens[seg] !== undefined) {
          ids.push(this.addedTokens[seg]);
          continue;
        }
        const matches = seg.match(this.pat);
        if (!matches) continue;
        for (const word of matches) {
          const encoded = Array.from(new TextEncoder().encode(word))
            .map(b => this.byteEncoder[b])
            .join('');
          const bpeTokens = this.bpe(encoded);
          for (const t of bpeTokens) {
            const id = this.vocab[t];
            ids.push(id !== undefined ? id : 1); // <unk>=1
          }
        }
      }
      return ids;
    }

    decode(ids) {
      const tokens = ids.map(id => this.invVocab[id] || '');
      // Filter out special tokens for display
      const text = tokens
        .filter(t => !t.startsWith('<') || !t.endsWith('>'))
        .join('');
      const bytes = Array.from(text).map(c => this.byteDecoder[c]).filter(b => b !== undefined);
      return new TextDecoder('utf-8', { fatal: false }).decode(new Uint8Array(bytes));
    }
  }

  // ===================== INFERENCE =====================

  async function generate(inputIds) {
    let ids = inputIds.slice(-MAX_CONTEXT);
    let generated = [];

    for (let i = 0; i < MAX_NEW_TOKENS; i++) {
      const input = new ort.Tensor('int64', BigInt64Array.from(ids.map(BigInt)), [1, ids.length]);
      const results = await session.run({ input_ids: input });
      const logits = results.logits.data;
      const vocabSize = 4096;
      const lastLogits = new Float32Array(vocabSize);
      const offset = (ids.length - 1) * vocabSize;
      for (let v = 0; v < vocabSize; v++) {
        lastLogits[v] = logits[offset + v] / TEMPERATURE;
      }

      // Top-k filtering
      const indexed = Array.from(lastLogits).map((v, i) => [v, i]);
      indexed.sort((a, b) => b[0] - a[0]);
      const topK = indexed.slice(0, TOP_K);

      // Softmax
      const maxVal = topK[0][0];
      let sumExp = 0;
      for (const item of topK) {
        item[0] = Math.exp(item[0] - maxVal);
        sumExp += item[0];
      }
      for (const item of topK) item[0] /= sumExp;

      // Sample
      let r = Math.random();
      let nextId = topK[topK.length - 1][1];
      for (const [prob, idx] of topK) {
        r -= prob;
        if (r <= 0) { nextId = idx; break; }
      }

      // Stop on special tokens
      const tok = tokenizer.invVocab[nextId] || '';
      if (tok === '<|user|>' || tok === '<|system|>' || tok === '<eos>' || nextId === 3) break;

      ids.push(nextId);
      generated.push(nextId);

      // Trim if too long
      if (ids.length > MAX_CONTEXT) {
        ids = ids.slice(ids.length - MAX_CONTEXT);
      }
    }
    return generated;
  }

  // ===================== UI =====================

  function addMessage(role, text) {
    const div = document.createElement('div');
    div.className = 'msg ' + role;
    div.textContent = text;
    chatEl.appendChild(div);
    chatEl.scrollTop = chatEl.scrollHeight;
    return div;
  }

  function showSuggestions() {
    suggestionsEl.innerHTML = '';
    for (const s of SUGGESTIONS) {
      const btn = document.createElement('button');
      btn.className = 'suggestion';
      btn.textContent = s;
      btn.onclick = () => { inputEl.value = s; sendMessage(); };
      suggestionsEl.appendChild(btn);
    }
  }

  function hideSuggestions() {
    suggestionsEl.innerHTML = '';
  }

  async function sendMessage() {
    const text = inputEl.value.trim();
    if (!text || generating) return;

    generating = true;
    sendBtn.disabled = true;
    inputEl.disabled = true;
    hideSuggestions();

    addMessage('user', text);
    inputEl.value = '';

    // Build conversation tokens
    const turnTokens = tokenizer.encode('\n<|user|> ' + text + '\n<|oracle|>');
    conversationIds.push(...turnTokens);

    // Show typing indicator
    const oracleDiv = addMessage('oracle', '');
    const dot = document.createElement('span');
    dot.className = 'typing';
    oracleDiv.appendChild(dot);

    statusEl.textContent = 'Generating...';

    try {
      const genIds = await generate(conversationIds);
      const response = tokenizer.decode(genIds).trim();

      conversationIds.push(...genIds);
      oracleDiv.textContent = response || "(empty response)";
    } catch (e) {
      oracleDiv.textContent = "(generation error: " + e.message + ")";
      console.error(e);
    }

    chatEl.scrollTop = chatEl.scrollHeight;
    statusEl.textContent = 'Ready';
    generating = false;
    sendBtn.disabled = false;
    inputEl.disabled = false;
    inputEl.focus();
  }

  sendBtn.addEventListener('click', sendMessage);
  inputEl.addEventListener('keydown', e => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  });

  // ===================== INIT =====================

  async function init() {
    try {
      statusEl.textContent = 'Loading tokenizer...';
      const tokResp = await fetch('tokenizer_chat_v2.json');
      const tokJson = await tokResp.json();
      tokenizer = new BPETokenizer(tokJson);

      statusEl.textContent = 'Loading model (14 MB)...';
      ort.env.wasm.numThreads = navigator.hardwareConcurrency || 4;
      session = await ort.InferenceSession.create('oracle_v2.onnx', {
        executionProviders: ['wasm'],
      });

      // Init conversation with system prompt
      conversationIds = tokenizer.encode('<|system|> ' + SYSTEM_PROMPT);

      statusEl.textContent = 'Generating greeting...';
      chatEl.innerHTML = '';
      addMessage('system-msg', '2.7M parameters loaded into your browser. No server, no API.');

      // Generate an opening line so Oracle introduces itself in-character
      const greetIds = tokenizer.encode('\n<|oracle|>');
      conversationIds.push(...greetIds);
      const greetGenIds = await generate(conversationIds);
      const greeting = tokenizer.decode(greetGenIds).trim();
      conversationIds.push(...greetGenIds);
      addMessage('oracle', greeting || "I'm Tiny Oracle. 2 million parameters of questionable wisdom.");

      statusEl.textContent = 'Ready';
      inputEl.disabled = false;
      sendBtn.disabled = false;
      inputEl.focus();
      showSuggestions();
    } catch (e) {
      statusEl.textContent = 'Error: ' + e.message;
      addMessage('system-msg', 'Failed to load: ' + e.message + '. Make sure oracle_v2.onnx and tokenizer_chat_v2.json are in the same directory.');
      console.error(e);
    }
  }

  init();
})();
</script>
</body>
</html>
